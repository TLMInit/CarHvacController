# Default to automatic text handling
* text=auto

# Enforce LF endings for source files
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Preserve CRLF for Windows batch scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat binary assets appropriately
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.bin binary
*.elf binary
