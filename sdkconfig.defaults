#
# ESP32-S3 Touch LCD 2 - CarHvacController
# sdkconfig.defaults for ESP-IDF 5.x/6.x
#

# Target
CONFIG_IDF_TARGET="esp32s3"

# PSRAM Configuration (required for LCD buffers)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Flash Configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition table - use default single factory app, large partition
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Watchdog - disable during development to see actual crash
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800

# LVGL Configuration
CONFIG_LV_CONF_SKIP=y

# LVGL Memory Configuration
CONFIG_LV_MEM_CUSTOM=n
CONFIG_LV_MEM_SIZE_KILOBYTES=128

# LVGL Color Configuration (16-bit for ST7789)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_COLOR_16_SWAP=y

# LVGL Fonts
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y

# Touch panel configuration
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=1

# Increased stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Enable user data in LVGL
CONFIG_LV_USE_USER_DATA=y

# Panic handler - print registers and reboot
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Console output
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Heap debugging - light poisoning for basic corruption detection
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_HEAP_TRACING_OFF=y
